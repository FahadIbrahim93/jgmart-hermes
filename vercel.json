{
  "version": 2,
  "rewrites": [
      { "source": "/", "destination": "/src/web/catalog/index.html" },
      { "source": "/catalog", "destination": "/src/web/catalog/index.html" },
      { "source": "/shop", "destination": "/src/web/catalog/index.html" },
      { "source": "/about", "destination": "/src/web/catalog/landing.html" },
      { "source": "/menu", "destination": "/src/web/catalog/menu.html" },
      { "source": "/track", "destination": "/src/web/catalog/track.html" },
      { "source": "/track.html", "destination": "/src/web/catalog/track.html" },
      { "source": "/zone", "destination": "/src/web/catalog/zone.html" },
      { "source": "/admin", "destination": "/src/web/catalog/admin.html" },
      { "source": "/admin.html", "destination": "/src/web/catalog/admin.html" },
      { "source": "/manifest", "destination": "/src/web/catalog/manifest.html" },
      { "source": "/manifest.html", "destination": "/src/web/catalog/manifest.html" },
      { "source": "/myorders", "destination": "/src/web/catalog/myorders.html" },
      { "source": "/myorders.html", "destination": "/src/web/catalog/myorders.html" },
      { "source": "/healthcheck", "destination": "/src/web/catalog/healthcheck.html" },
      { "source": "/offline", "destination": "/src/web/catalog/offline.html" },
      { "source": "/rider", "destination": "/src/web/catalog/rider.html" },
      { "source": "/rider.html", "destination": "/src/web/catalog/rider.html" },
      { "source": "/operator.html", "destination": "/src/web/catalog/operator.html" },
      { "source": "/dashboard", "destination": "/src/web/dashboard/index.html" },
      { "source": "/dashboard/", "destination": "/src/web/dashboard/index.html" },
      { "source": "/defaults.js", "destination": "/src/web/catalog/defaults.js" },
      { "source": "/catalog-init.js", "destination": "/src/web/catalog/catalog-init.js" },
      { "source": "/catalog_data.json", "destination": "/src/web/catalog/catalog_data.json" },
      { "source": "/offline-queue.js", "destination": "/src/web/catalog/offline-queue.js" },
      { "source": "/security.js", "destination": "/src/web/catalog/security.js" },
      { "source": "/data-store.js", "destination": "/src/web/catalog/data-store.js" },
      { "source": "/db.js", "destination": "/src/web/catalog/db.js" },
      { "source": "/order-state.js", "destination": "/src/web/catalog/order-state.js" },
      { "source": "/config.runtime.js", "destination": "/src/web/supabase/config.runtime.js" },
      { "source": "/manifest.json", "destination": "/src/web/catalog/manifest.json" },
      { "source": "/sw.js", "destination": "/src/web/catalog/sw.js" },
      { "source": "/images/:path*", "destination": "/src/web/catalog/images/:path*" },
      { "source": "/src/web/supabase/config.runtime.js", "destination": "/src/web/supabase/config.runtime.js" }
    ],
  "headers": [
    {
      "source": "/src/web/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
