{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/src/web/catalog/index.html" },
    { "source": "/catalog", "destination": "/src/web/catalog/index.html" },
    { "source": "/shop", "destination": "/src/web/catalog/index.html" },
    { "source": "/about", "destination": "/src/web/catalog/landing.html" },
    { "source": "/menu", "destination": "/src/web/catalog/menu.html" },
    { "source": "/track", "destination": "/src/web/catalog/track.html" },
    { "source": "/zone", "destination": "/src/web/catalog/zone.html" },
    { "source": "/admin", "destination": "/src/web/catalog/admin.html" },
    { "source": "/manifest", "destination": "/src/web/catalog/manifest.html" },
    { "source": "/myorders", "destination": "/src/web/catalog/myorders.html" },
    { "source": "/healthcheck", "destination": "/src/web/catalog/healthcheck.html" },
    { "source": "/offline", "destination": "/src/web/catalog/offline.html" },
    { "source": "/rider", "destination": "/src/web/catalog/rider.html" },
    { "source": "/dashboard", "destination": "/src/web/dashboard/index.html" },
    { "source": "/dashboard/", "destination": "/src/web/dashboard/index.html" }
  ],
  "headers": [
    {
      "source": "/src/web/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
