# JG Mart environment variables
# Copy to .env.local for local scripts (never commit real values)

# Supabase — Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel — GitHub Actions deploy (Settings → Secrets)
VERCEL_TOKEN=
VERCEL_ORG_ID=

# Optional: catalog admin PIN override (default in admin.html)
# JG_MART_ADMIN_PIN=
