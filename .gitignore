# Business binaries (keep in repo, but don't track generated)
*.docx
*.xlsx
*.pptx
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
# But DO track source brand assets, trackers, and catalog images
!assets/brand/**
!assets/images/**
!data/trackers/**
!docs/investor/**
!src/web/catalog/images/**
!src/web/dashboard/favicon.*

# Environment secrets
.env
.env.local
.env.*.local
!.env.example
src/web/supabase/config.local.js

# Cursor IDE (keep rules, ignore plans)
.cursor/plans/

# Agent archive is tracked; temp agent sandboxes are not
_archive/agents/**/node_modules/
